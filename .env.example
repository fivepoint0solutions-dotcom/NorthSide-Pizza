# Supabase
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Mapbox (public pk.* token — restrict it by URL in the Mapbox dashboard)
VITE_MAPBOX_TOKEN=pk.YOUR-TOKEN
# Optional: custom style built in Mapbox Studio. Falls back to a built-in style.
VITE_MAPBOX_STYLE_URL=mapbox://styles/YOUR-ACCOUNT/YOUR-STYLE-ID
